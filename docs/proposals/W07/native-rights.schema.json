{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://estate.example/internal/w07-native-rights-proposal-v1",
  "description": "Proposed server-only storage of the existing MlsPolicy port; never a public feed response.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "approvalState": { "enum": ["unapproved", "approved", "revoked"] },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "display": { "$ref": "#/$defs/PermissionState" },
        "replicate": { "$ref": "#/$defs/PermissionState" },
        "cache": { "$ref": "#/$defs/PermissionState" },
        "storeMedia": { "$ref": "#/$defs/PermissionState" },
        "alerts": { "$ref": "#/$defs/PermissionState" },
        "aiUse": { "$ref": "#/$defs/PermissionState" }
      },
      "required": ["display", "replicate", "cache", "storeMedia", "alerts", "aiUse"]
    },
    "allowedFields": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 80 } },
    "addressRule": { "enum": ["visible", "hidden", "listing_specific"] },
    "locationRule": { "enum": ["exact", "coarse", "hidden", "listing_specific"] },
    "maxDataAgeSeconds": { "$ref": "#/$defs/ResolvedNonnegativeOrNull" },
    "maxCacheAgeSeconds": { "$ref": "#/$defs/ResolvedNonnegativeOrNull" },
    "retentionDays": { "$ref": "#/$defs/ResolvedNonnegativeOrNull" },
    "attributionText": { "type": "string", "maxLength": 2000 },
    "attributionLogoAssetId": { "anyOf": [{ "type": "null" }, { "type": "string", "maxLength": 200 }] },
    "disclaimerVersion": { "type": "string", "maxLength": 200 }
  },
  "required": ["approvalState", "rights", "allowedFields", "addressRule", "locationRule", "maxDataAgeSeconds", "maxCacheAgeSeconds", "retentionDays", "attributionText", "attributionLogoAssetId", "disclaimerVersion"],
  "$defs": {
    "PermissionState": { "enum": ["allowed", "denied", "unknown"] },
    "ResolvedNonnegativeOrNull": { "anyOf": [{ "type": "null" }, { "type": "number", "minimum": 0 }] }
  }
}
