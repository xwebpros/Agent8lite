{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://estate.example/schemas/internal/campaign-workflow-event-v1",
  "title": "Native campaign workflow draft created v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "type",
    "version",
    "tenantId",
    "occurredAt",
    "ingestedAt",
    "producer",
    "aggregateType",
    "aggregateId",
    "correlationId",
    "payload"
  ],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "type": { "const": "campaign.workflow_draft_created" },
    "version": { "const": 1 },
    "tenantId": { "type": "string", "format": "uuid" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "ingestedAt": { "type": "string", "format": "date-time" },
    "producer": { "const": "marketing" },
    "aggregateType": { "const": "campaign_version" },
    "aggregateId": { "type": "string", "format": "uuid" },
    "correlationId": { "type": "string", "minLength": 1, "maxLength": 80 },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["campaignId", "workflowVersionId", "workflowVersion"],
      "properties": {
        "campaignId": { "type": "string", "format": "uuid" },
        "workflowVersionId": { "type": "string", "format": "uuid" },
        "workflowVersion": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
      }
    }
  }
}
