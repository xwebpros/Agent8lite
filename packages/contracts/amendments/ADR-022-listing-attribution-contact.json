{
  "schema": "Attribution",
  "property": "contact",
  "definition": {
    "anyOf": [
      {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "value"],
        "properties": {
          "kind": { "type": "string", "enum": ["email", "phone"] },
          "value": { "type": "string", "minLength": 1, "maxLength": 254 }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "email" } } },
            "then": { "properties": { "value": { "format": "email" } } }
          },
          {
            "if": { "properties": { "kind": { "const": "phone" } } },
            "then": {
              "properties": {
                "value": {
                  "minLength": 7,
                  "maxLength": 80,
                  "pattern": "^(?=(?:[+ ().-]*[0-9]){7})\\+?[0-9][0-9 ().-]*(?: (?:x|ext\\.?) ?[0-9]{1,6})?$"
                }
              }
            }
          }
        ]
      },
      { "type": "null" }
    ]
  }
}
