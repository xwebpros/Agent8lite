{
  "name": "estate-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {"node": "24.19.0"},
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "db:local": "node scripts/local-db.mjs",
    "db:migrate": "tsx packages/db/migrate.ts",
    "db:seed": "tsx packages/db/seed.ts",
    "db:verify-fresh": "node scripts/verify-fresh-db.mjs",
    "contracts:generate": "openapi-typescript packages/contracts/openapi.json --empty-objects-unknown -o packages/contracts/generated/api.ts",
    "contracts:check": "node scripts/check-contracts.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm --dir apps/web typecheck",
    "test": "vitest run",
    "test:isolated": "node scripts/test-isolated.mjs",
    "test:e2e": "playwright test",
    "build": "pnpm --dir apps/web build",
    "lint": "biome check apps/api/src apps/worker/src apps/web/app apps/web/components apps/web/lib packages/ui packages/auth packages/db packages/providers packages/storage packages/templates packages/cms packages/mls packages/contracts/internal scripts tests --diagnostic-level=error",
    "format": "biome format --write apps/api/src apps/worker/src apps/web/app apps/web/components apps/web/lib packages/ui packages/auth packages/db packages/providers packages/storage packages/templates packages/cms packages/mls packages/contracts/internal scripts tests"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "pg": "8.16.3",
    "drizzle-orm": "0.45.4",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "cookie-parser": "1.4.7",
    "lucide-react": "0.468.0",
    "@tanstack/react-query": "5.90.2",
    "bullmq": "5.61.0",
    "ioredis": "5.8.1"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsx": "4.20.6",
    "vitest": "5.0.3",
    "@playwright/test": "1.56.0",
    "@axe-core/playwright": "4.10.2",
    "openapi-typescript": "7.10.1",
    "@biomejs/biome": "2.2.5",
    "@types/node": "24.7.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/pg": "8.15.5",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "tailwindcss": "4.1.14",
    "@tailwindcss/postcss": "4.1.14"
  },
  "optionalDependencies": {
    "@embedded-postgres/windows-x64": "17.10.0-beta.17"
  }
}
