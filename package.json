{
  "name": "estate-workspace",
  "version": "0.1.0",
  "main": "scripts/start-app.mjs",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13.0 <23 || >=24.0.0 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:campaign-drafts": "node --import tsx scripts/enable-synthetic-campaign-drafts.mjs",
    "db:local": "node scripts/local-db.mjs",
    "db:migrate": "tsx packages/db/migrate.ts",
    "db:seed": "tsx packages/db/seed.ts",
    "db:verify-fresh": "node scripts/verify-fresh-db.mjs",
    "contracts:generate": "openapi-typescript packages/contracts/openapi.json --empty-objects-unknown -o packages/contracts/generated/api.ts",
    "contracts:check": "node scripts/check-contracts.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm --dir apps/web typecheck",
    "test": "vitest run",
    "test:isolated": "node scripts/test-isolated.mjs",
    "test:e2e": "playwright test",
    "build": "node scripts/build-app.mjs",
    "start": "node scripts/start-app.mjs",
    "build:runtime": "node scripts/build-runtime.mjs",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "verify:runtime:local": "node scripts/verify-runtime-local.mjs",
    "verify:launch:local": "node scripts/verify-launch-local.mjs",
    "start:api": "node scripts/start-runtime.mjs api",
    "start:worker": "node scripts/start-runtime.mjs worker",
    "lint": "biome check apps/api/src apps/worker/src apps/web/app apps/web/components apps/web/features apps/web/lib packages/ui packages/auth packages/db packages/providers packages/storage packages/templates packages/marketing packages/cms packages/mls packages/contracts/internal scripts tests --diagnostic-level=error",
    "format": "biome format --write apps/api/src apps/worker/src apps/web/app apps/web/components apps/web/features apps/web/lib packages/ui packages/auth packages/db packages/providers packages/storage packages/templates packages/marketing packages/cms packages/mls packages/contracts/internal scripts tests"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@tailwindcss/typography": "0.5.15",
    "@tanstack/react-query": "5.90.2",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/node": "24.7.2",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "bullmq": "5.61.0",
    "cookie-parser": "1.4.7",
    "drizzle-orm": "0.45.4",
    "ioredis": "5.8.1",
    "leaflet": "1.9.4",
    "lucide-react": "0.468.0",
    "next": "16.4.0",
    "pg": "8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "5.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@biomejs/biome": "2.2.5",
    "@playwright/test": "1.56.0",
    "@tailwindcss/postcss": "4.1.14",
    "@types/leaflet": "1.9.22",
    "openapi-typescript": "7.10.1",
    "tailwindcss": "4.1.14",
    "tsx": "4.20.6",
    "vitest": "5.0.3"
  },
  "optionalDependencies": {
    "@embedded-postgres/windows-x64": "17.10.0-beta.17"
  }
}
