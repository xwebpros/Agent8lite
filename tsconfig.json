{
  "compilerOptions": {
    "target": "ES2022", "module": "CommonJS", "moduleResolution": "Node",
    "lib": ["ES2022", "DOM"], "strict": true, "esModuleInterop": true,
    "resolveJsonModule": true, "skipLibCheck": true,
    "experimentalDecorators": true, "emitDecoratorMetadata": true,
    "types": ["node", "vitest/globals"], "noEmit": true
  },
  "include": ["apps/api/**/*.ts", "apps/worker/**/*.ts", "packages/**/*.ts", "tests/integration/**/*.ts", "tests/unit/**/*.ts", "tests/cms/**/*.ts", "tests/mls/**/*.ts"],
  "exclude": ["node_modules", "apps/web", "packages/ui", "packages/contracts/generated"]
}
