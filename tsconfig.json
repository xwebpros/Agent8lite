{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["node", "vitest/globals"],
    "noEmit": true
  },
  "include": [
    "apps/api/**/*.ts",
    "apps/worker/**/*.ts",
    "packages/**/*.ts",
    "tests/helpers/**/*.ts",
    "tests/integration/**/*.ts",
    "tests/unit/**/*.ts",
    "tests/unit/**/*.tsx",
    "tests/cms/**/*.ts",
    "tests/cms/**/*.tsx",
    "tests/mls/**/*.ts",
    "tests/control/**/*.ts",
    "tests/idx-template/**/*.ts",
    "tests/idx-template/**/*.tsx"
  ],
  "exclude": ["node_modules", "apps/web", "packages/ui", "packages/contracts/generated"]
}
